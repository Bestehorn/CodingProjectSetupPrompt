# Shared git hooks must keep LF line endings on every platform — a CRLF
# shell script fails to execute on Linux/macOS. Force LF regardless of
# the developer's core.autocrlf setting.
.githooks/** text eol=lf

# The same reasoning applies to every shell script this repo SHIPS (templates such as
# setup-hooks.sh): a CRLF bash script fails on Linux/macOS and produces confusing
# '<CR>: command not found' errors even in Git Bash. The agent hooks themselves are
# Python since 2026-10-01 and need no line-ending rule.
*.sh text eol=lf
# CONTRACT_VERSION is read line-wise by the hooks; keep it LF for the same reason.
claude-agents/spec-workflow/hooks/CONTRACT_VERSION text eol=lf
