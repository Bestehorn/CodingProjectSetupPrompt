tmp/*

# CV Customizer Agent Suite — runtime state and install outputs.
# Only the cli-agents/cv/ authoring tree is version-controlled; the following
# are regenerated per machine (machine-specific absolute paths) or per run.
.kiro/agent-state/
.kiro/agents/cv-*.json
.kiro/cv-suite/

# Python test/byproduct caches (the CV suite introduces pytest into the repo).
__pycache__/
*.py[cod]
.pytest_cache/

# Local virtual environment. The tracked .githooks/pre-commit hook resolves
# pre-commit from here (see .pre-commit-config.yaml); it is per-machine.
venv/
.venv/

# Hypothesis property-testing local database/cache (example DB, cached
# constants, unicode tables). Machine-specific and regenerated automatically.
.hypothesis/

# Claude Code per-run runtime state and machine-local settings. The AUTHORING trees
# (claude-agents/, claude-commands/, cli-agents/) are version-controlled; these are not:
# agent-state is per-run, worktrees are ephemeral, and settings.local.json is per-machine.
.claude/agent-state/
.claude/worktrees/
.claude/settings.local.json
