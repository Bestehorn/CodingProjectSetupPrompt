tmp/*

# Archived material (the CV suite, the legacy prompts): local only, never committed; the tag
# cv-suite-final restores it. Anchored to the root on purpose: an unanchored `archive/` would also
# ignore docs/archive/, which memory_compile.py writes and which must stay tracked.
/archive/

# Kiro per-run runtime state.
.kiro/agent-state/

# Python test/byproduct caches.
__pycache__/
*.py[cod]
.pytest_cache/

# Local virtual environment. The tracked .githooks/pre-commit hook resolves
# pre-commit from here (see .pre-commit-config.yaml); it is per-machine.
venv/
.venv/

# Hypothesis property-testing local database/cache (example DB, cached
# constants, unicode tables). Machine-specific and regenerated automatically.
.hypothesis/

# Claude Code per-run runtime state and machine-local settings. The AUTHORING trees
# (clients/, src/, templates/) are version-controlled; these are not:
# agent-state is per-run, worktrees are ephemeral, and settings.local.json is per-machine.
.claude/agent-state/
.claude/worktrees/
.claude/settings.local.json

# Check/test reports written by scripts/run_tests.py (--junit) and, in projects
# set up by these prompts, scripts/run_checks.py. Regenerated per run.
# NOTE: .secrets.baseline is deliberately NOT ignored — it is the audited
# secret-scan allow-list and the pre-commit hook fails on every clone without it.
# Anchored: an unanchored `reports/` would also ignore docs/reports/, where this repository's reports live.
/reports/
