def test_enqueue_refuses_red_ci_and_accepts_green(world: World) -> None:
    world.pr(1, "a.txt", "a changed\n", ci="failure", labels=())
    steward = ms.Steward(world.settings, world.git, world.host, ms.Report())
    assert steward.enqueue(1, allow_pending=False) == ms.EXIT_REFUSED
    assert "queue" not in world.host.labels_of(1)
    world.host.prs[1]["ci"] = "success"
    assert steward.enqueue(1, allow_pending=False) == ms.EXIT_OK
    assert "queue" in world.host.labels_of(1) and ("tick", None) in world.host.calls


