def test_the_push_credential_never_reaches_argv_and_is_deleted(tmp_path: Path, monkeypatch) -> None:
    seen: List[List[str]] = []

    def fake_run(command, **_kwargs):
        seen.append(list(command))
        return subprocess.CompletedProcess(command, 0, "", "")

    monkeypatch.setattr(ms.subprocess, "run", fake_run)
    repo = ms.Git(tmp_path, "merge-steward", "steward@example.invalid")
    repo.use_http_header("Authorization: Basic c2VjcmV0")
    repo.run("push", "origin", "HEAD")
    include = next(arg for arg in seen[0] if arg.startswith("include.path="))
    config = Path(include.split("=", 1)[1])
    assert "c2VjcmV0" in config.read_text(encoding="utf-8")
    assert not any("c2VjcmV0" in arg for arg in seen[0])
    repo.close()
    assert not config.exists()
