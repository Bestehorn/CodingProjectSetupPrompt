def landed_world(world: World, body: str) -> str:
    world.pr(1, "a.txt", "a changed\n")
    world.host.issues[101].body = body
    world.host.issues[101].comments.append("merge-steward: claim-started 2026-10-26T08:00:00Z")
    world.tick()
    world.set_trains("success")
    world.tick()
    return world.main()


def test_a_green_deploy_containing_the_landing_verifies_and_closes(world: World) -> None:
    sha = landed_world(world, "- [x] implement\n- [ ] the dev check passes (post-deploy)\n")
    world.verdict(sha, "success")
    issue = world.host.issues[101]
    assert issue.state == "closed"
    assert "- [x] the dev check passes (post-deploy)" in issue.body
    assert "verified" in issue.labels and "awaiting-verification" not in issue.labels
    assert "in-progress" not in issue.labels
    closing = issue.comments[-1]
    assert "verified" in closing and "2/2" in closing and "Time spent" in closing


def test_the_verdict_is_idempotent(world: World) -> None:
    sha = landed_world(world, "- [x] implement\n")
    world.verdict(sha, "success")
    count = len(world.host.issues[101].comments)
    world.host.issues[101].state = "open"
    world.host.issues[101].labels.append("awaiting-verification")
    world.verdict(sha, "success")
    assert len(world.host.issues[101].comments) == count


def test_an_issue_waits_for_every_pr_it_queued(world: World) -> None:
    world.pr(2, "b.txt", "b changed\n", labels=())  # the issue's second PR, still open and not yet queued
    sha = landed_world(world, "- [x] implement\n")
    world.host.issues[101].comments.append("merge-steward: queued PR #2")
    world.verdict(sha, "success")
    issue = world.host.issues[101]
    assert issue.state == "open" and "awaiting-verification" in issue.labels


def test_an_interrupted_verdict_is_completed_by_the_next_one(world: World) -> None:
    sha = landed_world(world, "- [x] implement\n")
    world.host.fail_once["issue_close"] = 1
    with pytest.raises(ms.HostError):
        world.verdict(sha, "success")
    issue = world.host.issues[101]
    assert issue.state == "open" and "awaiting-verification" in issue.labels, "still a candidate"
    world.verdict(sha, "success")
    issue = world.host.issues[101]
    assert issue.state == "closed" and "awaiting-verification" not in issue.labels
    assert sum("merge-steward: verified" in c for c in issue.comments) == 1


def test_open_checklist_items_keep_the_issue_open_for_a_session(world: World) -> None:
