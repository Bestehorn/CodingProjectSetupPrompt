#!/usr/bin/env bash
# .githooks/pre-commit — VERSION-CONTROLLED, shared pre-commit hook.
#
# This file lives in the repo's tracked `.githooks/` directory (NOT in the
# untracked `.git/hooks/`), so the standard it enforces travels with the
# project to every clone and developer. Git runs it because the repo sets
# `core.hooksPath=.githooks` in local config (done once per clone by
# `scripts/setup-hooks.sh`; see the project's Part 2.3 / README).
#
# Runs only the FAST checks: lint (ruff + ruff-format) and security (bandit
# over the staged files, plus a secret scan). Under two seconds, so commit as
# often as you like — that is the point.
#
# Deliberately NOT here:
#   * the TEST SUITE — CI owns it. A project whose suite takes an hour cannot
#     pay for it per commit, and gating commits on it is what drives agents to
#     one giant commit instead of a readable series. See the
#     CI-owns-the-test-suite rule.
#   * mypy — a whole-project analysis, so it belongs at the push boundary
#     (`.githooks/pre-push`) rather than at every commit.
# The secret scan IS here, because a leaked credential is the one defect class
# that cannot be undone once it is pushed.
#
# Portable by design: it does NOT hardcode an absolute venv path. It locates
# the project's venv at runtime from the main checkout, so the same committed
# file works on every machine, OS, and inside git worktrees (where the venv
# lives in the MAIN checkout, not the worktree).
set -euo pipefail

# Resolve the MAIN working tree (the parent of the common git dir). From a
# normal checkout this is the repo root; from a worktree it is the main repo
# root — which is where the venv lives.
#
# A RELATIVE --git-common-dir is relative to the CURRENT directory, not to the
# top level of the working tree. Git invokes hooks from the working-tree root so
# the two coincide here, but joining against $PWD is correct in both cases and
# keeps the hook working when it is run by hand from a subdirectory.
GIT_COMMON_DIR="$(git rev-parse --git-common-dir)"
case "$GIT_COMMON_DIR" in
    /*|[A-Za-z]:*) ;;                                  # already absolute
    *) GIT_COMMON_DIR="$PWD/$GIT_COMMON_DIR" ;;
esac
MAIN_CHECKOUT="$(cd "$(dirname "$GIT_COMMON_DIR")" && pwd)"

# Locate the venv pre-commit executable (Windows vs *nix layout).
if [ -x "$MAIN_CHECKOUT/venv/Scripts/pre-commit.exe" ]; then
    PRECOMMIT="$MAIN_CHECKOUT/venv/Scripts/pre-commit.exe"
elif [ -x "$MAIN_CHECKOUT/venv/bin/pre-commit" ]; then
    PRECOMMIT="$MAIN_CHECKOUT/venv/bin/pre-commit"
else
    echo "ERROR: pre-commit not found in the project venv under $MAIN_CHECKOUT/venv" >&2
    echo "Create/refresh the venv:  python -m venv venv && pip install -e '.[dev]'" >&2
    exit 1
fi

# Run every hook declared with `stages: [pre-commit]` in .pre-commit-config.yaml,
# against the staged files for this commit. Running the STAGE rather than naming
# hook ids keeps that config file the single source of truth for what runs when —
# adding a fast check there requires no edit to this hook.
exec "$PRECOMMIT" run --hook-stage pre-commit \
    --config "$MAIN_CHECKOUT/.pre-commit-config.yaml"
