# The `steward-wake` job — APPEND it to the project's CI workflow (the one config/delivery.json names as
# `steward.ci_workflow`, e.g. .github/workflows/ci.yml), under `jobs:`, and list every other job of that workflow in
# its `needs:`. Installed from templates/ci/github-steward-wake.yml.template.
#
# Why: the merge steward starts every train's CI with GITHUB_TOKEN, and GitHub starts no workflow from an event that
# token caused — except `workflow_dispatch`. So a train finishing can wake the steward only by DISPATCHING it, which
# is what this job does with the run's own GITHUB_TOKEN. It runs on train runs only (`steward/train-**`), whatever the
# other jobs concluded (`always()`): a red train needs the steward's judgement as much as a green one. The steward it
# starts is the DEFAULT BRANCH's copy (the dispatch names that ref), so nothing a train contains can change it.
#
# The token reaches the request on stdin (no-environment-vars); `github.*` values are GitHub-controlled. Use the
# same `runs-on` as the project's other CI jobs (any runner with bash and python3). This job can NEVER turn a train
# red: it is `continue-on-error`, and the request reports a failed dispatch instead of failing — a green change must
# not be returned as `queue-failed` because a wake-up failed (the 30-minute schedule and `wait-landed` cover a lost
# one).
  steward-wake:
    if: ${{ always() && startsWith(github.ref_name, 'steward/train-') }}
    needs: [{{EVERY_OTHER_CI_JOB}}] # e.g. [quality, tests, ui] — every job of this workflow except this one
    runs-on: {{STEWARD_RUNS_ON}}
    timeout-minutes: 5
    continue-on-error: true
    permissions:
      actions: write # dispatch the merge steward workflow
    steps:
      - name: Wake the merge steward (this train's verdict is in)
        shell: bash
        run: >-
          printf '%s\n' '${{ github.token }}' | python3 -c "import json,sys,urllib.request;
          token=sys.stdin.readline().strip();
          url='${{ github.api_url }}/repos/${{ github.repository }}/actions/workflows/{{STEWARD_WORKFLOW_FILE}}/dispatches';
          body=json.dumps({'ref': '${{ github.event.repository.default_branch }}'}).encode();
          request=urllib.request.Request(url, data=body, method='POST', headers={'Authorization': 'Bearer ' + token,
          'Accept': 'application/vnd.github+json', 'X-GitHub-Api-Version': '2022-11-28'});
          exec('try:\n urllib.request.urlopen(request, timeout=30); print(\'merge steward dispatched\')\nexcept
          Exception as exc:\n print(\'merge steward NOT dispatched:\', exc)')"
