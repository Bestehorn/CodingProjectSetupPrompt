# ------------------------------------------------------------------------------------------- conventions
# The text conventions shared with the git wrapper, the agents and the watcher. Change them together.

#: An issue reference: `#12`; for closing keywords also `group/project#12` and an issue URL.
_LOCAL_REF = r"(?<![\w/])#\d+"
_ANY_REF = r"(?:[\w.-]+(?:/[\w.-]+)+)?#\d+|https?://[^\s)\]]+/issues/\d+"


def _ref_list(ref: str) -> str:
    """One reference or a list of them: `#12, #13 and #14`, `#12 #13`, `issues #12 & #13`."""
    return rf"(?:{ref})(?:\s*(?:,|&|\band\b)?\s*(?:issues?\s+)?(?:{ref}))*"


#: The way a PR names the issue(s) it delivers: `Refs #12` / `References: #12, #13` by default; a project sets
#: its own words with `steward.reference_keywords`. "Part of", "related to" and a bare mention are NOT
#: references unless configured — the steward acts on every referenced issue (the landing line, verification and
#: closing, returning it with its claim released), so a mention must never count as one.
def refs_pattern(keywords: Sequence[str]) -> "re.Pattern[str]":
    words = "|".join(r"\s+".join(re.escape(part) for part in str(word).split()) for word in keywords)
    return re.compile(rf"\b(?:{words})\b\s*:?\s+(?:issues?\s+)?(?P<list>{_ref_list(_LOCAL_REF)})", re.I)


REFS_RE = refs_pattern(["refs", "references"])


def configure_references(keywords: Sequence[str]) -> None:
    """Use the project's reference words for every reference this process reads."""
    global REFS_RE
    REFS_RE = refs_pattern(keywords)


#: A closing keyword as GitHub and GitLab's DEFAULT patterns read a PR description or a commit message (GitLab
#: also takes "implements" and the -ing forms): the host closes the issue when the commit reaches the default
#: branch — before any deploy check. Deliberately wider than either host; an instance with a CUSTOM GitLab
#: closing pattern is not covered by this and must keep the default under `verification: watcher`.
CLOSING_RE = re.compile(
    r"\b(?:clos(?:e[sd]?|ing)|fix(?:e[sd]|ing)?|resolv(?:e[sd]?|ing)|implement(?:s|ed|ing)?)\b\s*:?\s+"
    rf"(?:issues?\s+)?(?P<list>{_ref_list(_ANY_REF)})",
    re.I,
)
LOCAL_NUMBER_RE = re.compile(r"(?<![\w/])#(\d+)")
ANY_NUMBER_RE = re.compile(r"(?:#|/issues/)(\d+)")
DEPENDS_RE = re.compile(r"^\s*Depends-on\s*:\s*(.+)$", re.IGNORECASE | re.MULTILINE)
NUMBER_RE = re.compile(r"#(\d+)")
#: The one machine-readable landing record. The LAST such line on an issue is its current landing.
LANDED_RE = re.compile(r"^merge-steward: landed ([0-9a-f]{7,40})\b", re.MULTILINE)
QUEUED_LINE = "merge-steward: queued PR #{pr}"
QUEUED_RE = re.compile(r"^merge-steward: queued PR #(\d+)", re.MULTILINE)
CULPRIT_MARK = "<!-- merge-steward-culprit:{sha} -->"
CLAIM_STARTED_RE = re.compile(r"^merge-steward: claim-started (\S+)", re.MULTILINE)
CHECKBOX_RE = re.compile(r"^(\s*[-*]\s*)\[( |x|X)\](.*)$")
POST_DEPLOY_MARK = "(post-deploy)"
VERDICT_MARK = "<!-- merge-steward-verdict:{conclusion}:{sha} -->"
RETRY_MARK = "<!-- merge-steward-retry -->"
TRAILER_RE = re.compile(r"^(Steward-[A-Za-z]+):\s*(.*)$", re.MULTILINE)
TRAIN_REF_RE = re.compile(r"^refs/heads/(?P<branch>.+-(?P<batch>\d{14}[0-9a-f]{0,12})-(?P<index>\d+))$")


def utcnow() -> dt.datetime:
    return dt.datetime.now(dt.timezone.utc)


def iso(moment: dt.datetime) -> str:
    return moment.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_iso(text: str) -> Optional[dt.datetime]:
    try:
        return dt.datetime.fromisoformat(text.strip().replace("Z", "+00:00"))
    except ValueError:
        return None


def referenced_issues(body: str) -> Tuple[List[int], List[int]]:
    """(the issues of THIS repository the text references — `Refs` lists and closing-keyword lists —, the
    issue numbers it names with a CLOSING keyword, in any repository) — sorted, unique."""
    refs: set = set()
    closing: set = set()
    for match in REFS_RE.finditer(body or ""):
        refs.update(int(n) for n in LOCAL_NUMBER_RE.findall(match.group("list")))
    for match in CLOSING_RE.finditer(body or ""):
        closing.update(int(n) for n in ANY_NUMBER_RE.findall(match.group("list")))
        refs.update(int(n) for n in LOCAL_NUMBER_RE.findall(match.group("list")))
    return sorted(refs), sorted(closing)


def closing_line(text: str) -> Optional[str]:
    """The first line of `text` that carries a closing keyword with an issue reference, or None."""
    for line in (text or "").splitlines():
        if CLOSING_RE.search(line):
            return line.strip()
    return None


def depends_on(body: str) -> List[int]:
    found: List[int] = []
    for line in DEPENDS_RE.findall(body or ""):
        for number in NUMBER_RE.findall(line):
            if int(number) not in found:
                found.append(int(number))
    return found


def deployed_sha(event: Dict[str, Any]) -> str:
    """The commit a GitHub deploy run deploys, read from its event payload (`${{ github.event_path }}`): the
    dispatch input `sha` (the steward's dispatch), else the pushed `after` (a direct merge's trunk push). Read
    from the FILE, so the workflow needs no `env:` map to pass an untrusted dispatch input to a shell safely."""
    sha = str((event.get("inputs") or {}).get("sha") or event.get("after") or "").strip()
    if not re.fullmatch(r"[0-9a-f]{40}", sha):
        raise ConfigError(f"the event names no 40-hex commit to deploy (got {sha[:60]!r})")
    return sha


def read_event(path: str) -> Dict[str, Any]:
    try:
        data = json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise ConfigError(f"cannot read the event payload {path!r} ({exc})") from exc
    if not isinstance(data, dict):
        raise ConfigError(f"the event payload {path!r} is not an object")
    return data


def checklist_counts(body: str) -> Tuple[int, int, List[str]]:
    """(ticked, total, the unticked items' text) over the `- [ ]` / `- [x]` lines outside code fences."""
    ticked = total = 0
    open_items: List[str] = []
    fenced = False
    for line in (body or "").splitlines():
        if line.strip().startswith(("```", "~~~")):
            fenced = not fenced
            continue
        match = None if fenced else CHECKBOX_RE.match(line)
        if not match:
            continue
        total += 1
        if match.group(2) in ("x", "X"):
            ticked += 1
        else:
            open_items.append(match.group(3).strip())
    return ticked, total, open_items


def tick_post_deploy_items(body: str) -> Tuple[str, int]:
    """The body with every unticked `(post-deploy)` item ticked, and how many were ticked."""
    out: List[str] = []
    count = 0
    fenced = False
    for line in (body or "").split("\n"):
        if line.strip().startswith(("```", "~~~")):
            fenced = not fenced
            out.append(line)
            continue
        match = None if fenced else CHECKBOX_RE.match(line.rstrip("\r"))
        if match and match.group(2) == " " and POST_DEPLOY_MARK in match.group(3).lower():
            ending = "\r" if line.endswith("\r") else ""
            out.append(f"{match.group(1)}[x]{match.group(3)}{ending}")
            count += 1
        else:
            out.append(line)
    return "\n".join(out), count


def last_landing(comments: Iterable[str]) -> Optional[str]:
    landed: Optional[str] = None
    for text in comments:
        for match in LANDED_RE.finditer(text or ""):
            landed = match.group(1)
    return landed


def claim_started(comments: Iterable[str]) -> Optional[dt.datetime]:
    started: Optional[dt.datetime] = None
    for text in comments:
        for match in CLAIM_STARTED_RE.finditer(text or ""):
            started = parse_iso(match.group(1)) or started
    return started


def elapsed_text(start: Optional[dt.datetime], end: dt.datetime) -> str:
    if start is None:
        return "not recorded"
    minutes = max(0, int((end - start).total_seconds() // 60))
    return f"{minutes // 60} h {minutes % 60:02d} min"


# ---------------------------------------------------------------------------------------------- settings


class ConfigError(RuntimeError):
    """config/delivery.json is missing a required value or carries an unknown one."""


@dataclass
class Settings:
    merge: str
    verification: str
    trunk: str
    host: str
    remote: str
    steward: Dict[str, Any]

    def label(self, key: str) -> str:
        return str(self.steward[key])

    @property
    def batch_size(self) -> int:
        return 1 if not self.steward["parallel_trains"] else max(1, int(self.steward["batch_size"]))


def load_settings(path: Path = CONFIG_PATH) -> Settings:
    try:
        raw = json.loads(path.read_text(encoding="utf-8")) if path.is_file() else {}
    except (OSError, ValueError) as exc:
        raise ConfigError(f"{path}: not readable JSON ({exc})") from exc
    if not isinstance(raw, dict):
        raise ConfigError(f"{path}: the top level must be an object")
    steward = dict(STEWARD_DEFAULTS)
    extra = raw.get("steward", {})
    if not isinstance(extra, dict):
        raise ConfigError(f"{path}: 'steward' must be an object")
    unknown = sorted(set(extra) - set(STEWARD_DEFAULTS) - {"_comment"})
    if unknown:
        raise ConfigError(f"{path}: unknown steward setting(s) {unknown} — a typo would silently use a default")
    steward.update({k: v for k, v in extra.items() if k != "_comment"})
    settings = Settings(
        merge=str(raw.get("merge", "direct")),
        verification=str(raw.get("verification", "session")),
        trunk=str(raw.get("trunk", "main")),
        host=str(raw.get("host", "github")),
        remote=str(raw.get("remote", "origin")),
        steward=steward,
    )
    if settings.merge not in MERGE_MODES:
        raise ConfigError(f"{path}: merge must be one of {MERGE_MODES}, not {settings.merge!r}")
    if settings.verification not in VERIFICATION_MODES:
        raise ConfigError(f"{path}: verification must be one of {VERIFICATION_MODES}, not {settings.verification!r}")
    if settings.host not in HOSTS:
        raise ConfigError(f"{path}: host must be one of {HOSTS}, not {settings.host!r}")
    if not str(steward["train_prefix"]).endswith("-") or ".." in str(steward["train_prefix"]):
        raise ConfigError(f"{path}: train_prefix must end with '-' and contain no '..'")
    words = steward["reference_keywords"]
    if not isinstance(words, list) or not words or not all(isinstance(w, str) and w.strip() for w in words):
        raise ConfigError(f"{path}: steward.reference_keywords must be a non-empty list of words")
    closing = [w for w in words if CLOSING_RE.search(f"{w} #1")]
    if closing:
        raise ConfigError(
            f"{path}: steward.reference_keywords {closing} are closing keywords — the host would close the issue "
            "at landing, before the deploy check"
        )
    return settings


# ------------------------------------------------------------------------------------------------- git


class GitError(RuntimeError):
    pass


#: The variables with which a parent git process points its children at ITS repository (`git rev-parse
#: --local-env-vars`). Run from a git hook or under another git command, the steward would otherwise read and
#: push a different clone than the one it was started in.
GIT_LOCAL_ENV = (
    "GIT_ALTERNATE_OBJECT_DIRECTORIES",
    "GIT_COMMON_DIR",
    "GIT_CONFIG",
    "GIT_CONFIG_COUNT",
    "GIT_CONFIG_PARAMETERS",
    "GIT_DIR",
    "GIT_GRAFT_FILE",
    "GIT_IMPLICIT_WORK_TREE",
    "GIT_INDEX_FILE",
    "GIT_INTERNAL_SUPER_PREFIX",
    "GIT_NAMESPACE",
    "GIT_NO_REPLACE_OBJECTS",
    "GIT_OBJECT_DIRECTORY",
    "GIT_PREFIX",
    "GIT_REPLACE_REF_BASE",
    "GIT_SHALLOW_FILE",
    "GIT_WORK_TREE",
)


def isolated_git_env() -> Dict[str, str]:
    """This process's environment without any variable that would point git at another repository."""
    return {
        key: value
        for key, value in os.environ.items()
        if key not in GIT_LOCAL_ENV and not key.startswith(("GIT_CONFIG_KEY_", "GIT_CONFIG_VALUE_"))
    }


class Git:
    """git in one working directory, with hooks disabled (the PR content is data, never code to run here)."""

    def __init__(self, cwd: Path, user_name: str, user_email: str) -> None:
        self.cwd = cwd
        self._hooks = Path(tempfile.mkdtemp(prefix="steward-nohooks-"))
        self._identity = ["-c", f"user.name={user_name}", "-c", f"user.email={user_email}"]
        self._private: List[Path] = []
        self.extra: List[str] = []

    def use_http_header(self, header: str) -> None:
        """Send `header` with every HTTP request git makes (the GitLab push credential). It lives in a private temp
        config file that git INCLUDES, so the secret is never in argv (readable by every process on the runner),
        in the remote URL, in .git/config or in an error message; `close` deletes it."""
        folder = Path(tempfile.mkdtemp(prefix="steward-cfg-"))
        self._private.append(folder)
        path = folder / "credential.gitconfig"
        path.write_text(f"[http]\n\textraHeader = {header}\n", encoding="utf-8")
        os.chmod(path, 0o600)
        self.extra += ["-c", f"include.path={path.as_posix()}"]

    def close(self) -> None:
        shutil.rmtree(self._hooks, ignore_errors=True)
        for folder in self._private:
            shutil.rmtree(folder, ignore_errors=True)

    def run(self, *args: str, check: bool = True) -> subprocess.CompletedProcess:
        command = [
            "git",
            "-c",
            f"core.hooksPath={self._hooks}",
            "-c",
            "commit.gpgsign=false",
            "-c",
            "advice.detachedHead=false",
            *self._identity,
            *self.extra,
            *args,
        ]
        completed = subprocess.run(  # nosec B603  # fixed argv, no shell
            command,
            cwd=str(self.cwd),
            env=isolated_git_env(),
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            stdin=subprocess.DEVNULL,
        )
        if check and completed.returncode != 0:
            raise GitError(f"git {' '.join(args)} failed ({completed.returncode}): {completed.stderr.strip()[:800]}")
        return completed

    def out(self, *args: str) -> str:
        return self.run(*args).stdout.strip()

    def rev(self, ref: str) -> str:
        return self.out("rev-parse", "--verify", ref + "^{commit}")

    def is_ancestor(self, ancestor: str, descendant: str) -> bool:
        return self.run("merge-base", "--is-ancestor", ancestor, descendant, check=False).returncode == 0

    def has_commit(self, sha: str) -> bool:
        return self.run("cat-file", "-e", sha + "^{commit}", check=False).returncode == 0

    def trailers(self, sha: str) -> Dict[str, str]:
        message = self.out("log", "-1", "--format=%B", sha)
        return {key: value.strip() for key, value in TRAILER_RE.findall(message)}

    def merge(self, sha: str, message: str) -> Tuple[bool, List[str]]:
        result = self.run("merge", "--no-ff", "--no-edit", "-m", message, sha, check=False)
        if result.returncode == 0:
            return True, []
        conflicted = self.run("diff", "--name-only", "--diff-filter=U", check=False).stdout.split()
        self.run("merge", "--abort", check=False)
        return False, conflicted or [result.stderr.strip()[:200] or "merge failed"]


# ----------------------------------------------------------------------------------------------- model


@dataclass
class PullRequest:
    number: int
    title: str
    head_sha: str
    base_ref: str
    draft: bool
    body: str
    url: str
    labels: List[str] = field(default_factory=list)
    enqueued_at: str = ""

    @property
    def issues(self) -> List[int]:
        return referenced_issues(self.body)[0]

    @property
    def closing_issues(self) -> List[int]:
        return referenced_issues(self.body)[1]

    @property
    def closing_text(self) -> Optional[str]:
        """The description line that would make the host close an issue when this PR's commits land."""
        return closing_line(self.body)

    @property
    def depends(self) -> List[int]:
        return depends_on(self.body)


@dataclass
class Issue:
    number: int
