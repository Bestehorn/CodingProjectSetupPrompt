@dataclass
class Report:
    dry_run: bool = False
    lines: List[str] = field(default_factory=list)

    def say(self, text: str) -> None:
        self.lines.append(text)
        print(("[dry-run] " if self.dry_run else "") + text, flush=True)


# ---------------------------------------------------------------------------------------------- steward


class Steward:
    def __init__(self, settings: Settings, git: Git, host: HostAPI, report: Report, run_url: str = "") -> None:
        self.s = settings
        self.git = git
        self.host = host
        self.report = report
        self.run_url = run_url
        self.dry = report.dry_run
        self._queued_refs: Optional[Dict[int, set]] = None  # issue -> queued PRs referencing it (one verdict run)
        self._batches: set = set()  # every batch id this process has built OR judged — never reused
        configure_references(settings.steward["reference_keywords"])

    # -- small helpers --------------------------------------------------------------------------------
    @property
    def trunk_ref(self) -> str:
        return f"refs/remotes/{self.s.remote}/{self.s.trunk}"

    def fetch(self) -> str:
        prefix = str(self.s.steward["train_prefix"])
        self.git.run(
            "fetch",
            "--prune",
            "--no-auto-gc",
            self.s.remote,
            f"+refs/heads/{self.s.trunk}:{self.trunk_ref}",
            f"+refs/heads/{prefix}*:refs/remotes/{self.s.remote}/{prefix}*",
        )
        return self.git.rev(self.trunk_ref)

    def _do(self, what: str, action: Any, *args: Any) -> None:
        """Every tracker or remote write goes through here, so --dry-run is complete by construction."""
        self.report.say(what)
        if not self.dry:
            action(*args)

    def _issue_labels(self, number: int, add: Sequence[str] = (), remove: Sequence[str] = ()) -> None:
        for label in remove:
            self._do(f"issue #{number}: -label {label}", self.host.issue_remove_label, number, label)
        if add:
            self._do(f"issue #{number}: +label {', '.join(add)}", self.host.issue_add_labels, number, list(add))

    def _return_issue(self, number: int, reason_label: str, text: str) -> None:
        """Hand an issue back to the pool: rework label, claim released, the reason on the issue."""
        self._issue_labels(number, add=[reason_label])
        self._do(
            f"issue #{number}: release claim",
            self.host.issue_release_claim,
            number,
            self.s.label("in_progress_label"),
        )
        self._do(f"issue #{number}: comment", self.host.issue_comment, number, text)

    # -- trains ---------------------------------------------------------------------------------------
    def trains_in_flight(self) -> Dict[str, List[Train]]:
        prefix = str(self.s.steward["train_prefix"])
        listing = self.git.out(
            "for-each-ref", "--format=%(objectname) %(refname)", f"refs/remotes/{self.s.remote}/{prefix}*"
        )
        batches: Dict[str, List[Train]] = {}
        for line in listing.splitlines():
            sha, _, ref = line.partition(" ")
            head_ref = "refs/heads/" + ref[len(f"refs/remotes/{self.s.remote}/") :]
            match = TRAIN_REF_RE.match(head_ref)
            if not match or not match.group("branch").startswith(prefix):
                continue
            trailers = self.git.trailers(sha)
            prs = [int(n) for n in NUMBER_RE.findall(trailers.get("Steward-PRs", ""))]
            train = Train(
                batch=match.group("batch"),
                index=int(match.group("index")),
                branch=match.group("branch"),
                sha=sha,
                prs=prs,
                base=trailers.get("Steward-Base", ""),
            )
            batches.setdefault(train.batch, []).append(train)
        for trains in batches.values():
            trains.sort(key=lambda t: t.index)
        return batches

    def delete_trains(self, trains: Sequence[Train]) -> None:
        if not trains:
            return
        refspecs = [f":refs/heads/{t.branch}" for t in trains]
        self._do(
            f"delete train branches {', '.join(t.branch for t in trains)}",
            self.git.run,
            "push",
            self.s.remote,
            *refspecs,
        )

    def train_age_minutes(self, train: Train) -> float:
        stamp = self.git.out("log", "-1", "--format=%cI", train.sha)
        moment = parse_iso(stamp)
        return (utcnow() - moment).total_seconds() / 60.0 if moment else 0.0

    # -- 0. reverify ----------------------------------------------------------------------------------
    def reverify(self, trunk: str) -> None:
        if self.s.verification != "watcher":
            return
        label = self.s.label("reverify_label")
        asked = self.host.issues_with_label(label)
        if not asked:
            return
        self._do(
            f"deploy {trunk[:12]} for re-verification (asked by {', '.join(f'#{n}' for n in asked)})",
            self.host.redeploy,
            trunk,
        )
        for number in asked:
            self._issue_labels(number, remove=[label])
            self._do(
                f"issue #{number}: comment",
                self.host.issue_comment,
                number,
                f"merge-steward: re-verification deploy of `{trunk[:12]}` started{self._run_suffix()}.",
            )

    def _run_suffix(self) -> str:
        return f" ({self.run_url})" if self.run_url else ""

    # -- 1 + 2. finish and land -----------------------------------------------------------------------
    def finish(self, trunk: str) -> bool:  # noqa: C901 — one verdict per train state, in order
        """True when a batch is still in flight (the tick must not plan another)."""
        batches = self.trains_in_flight()
        # A batch judged and deleted here is gone from the remote, but its id must never be built again in this
        # process: a retry rebuilt within the same second would reuse it, produce byte-identical train commits,
        # and the culprit mark of the first judgement would then read as "already judged".
        self._batches.update(batches)
        if not batches:
            return False
        in_flight = False
        for batch, trains in sorted(batches.items()):
            base = trains[0].base
            landed_upto = self._landed_upto(trains, trunk)
            if base != trunk and not landed_upto:
                self.report.say(
                    f"batch {batch}: the trunk moved past its base {base[:12]} — abandoned; its PRs stay queued"
                )
                self.delete_trains(trains)
                continue
            if landed_upto:
                # The trunk already contains train `landed_upto`: an earlier tick pushed it and stopped before its
                # bookkeeping was done (a host error, a timeout, a lost runner). Finish that bookkeeping now —
                # every step is idempotent — instead of abandoning PRs that already landed.
                self.report.say(f"batch {batch}: train {landed_upto} is on the trunk already — completing the landing")
            states = []
            for train in trains:
                state, url = self.host.ci_state(train.branch, train.sha)
                if state == "missing":
                    age = self.train_age_minutes(train)
                    if age > 2 * float(self.s.steward["dispatch_grace_minutes"]):
                        state = "error"
                    elif age > float(self.s.steward["dispatch_grace_minutes"]):
                        self._start_ci(train, "no CI run yet — dispatching again")
                        state = "pending"
                    else:
                        state = "pending"
                if state == "pending" and self.train_age_minutes(train) > float(
                    self.s.steward["train_timeout_minutes"]
                ):
                    state = "error"
                states.append((train, state, url))
            if any(state == "pending" for _t, state, _u in states):
                self.report.say(f"batch {batch}: " + ", ".join(f"train {t.index} {s}" for t, s, _u in states))
                in_flight = True
                continue
            if not self.land(batch, states, trunk, landed_upto):
                in_flight = True  # the landing's bookkeeping is incomplete: the next tick completes it first
        return in_flight

    def _landed_upto(self, trains: Sequence[Train], trunk: str) -> int:
        """The index of the newest train of the batch the trunk already contains, 0 when none."""
        found = 0
        for train in trains:
            if train.sha == trunk or self.git.is_ancestor(train.sha, trunk):
                found = max(found, train.index)
        return found

    def _start_ci(self, train: Train, why: str) -> None:
        try:
            self._do(f"train {train.branch}: {why}", self.host.trigger_ci, train.branch)
        except HostError as exc:
            # A train whose run never starts goes "missing" and then "error": retried once, then blamed.
            self.report.say(f"train {train.branch}: CI could not be started ({exc})")

    def _still_landable(self, states: Sequence[Tuple[Train, str, str]]) -> int:
        """How many of the green trains may still land: a train stops the prefix when the PR it added has moved
        on since the train was built (its head is not the commit the train merged and tested), left the queue,
        is on hold or is no longer open. Its later commits were never tested, and a dequeue is the author's."""
        for position, (train, _state, _url) in enumerate(states):
            if not train.prs:
                continue
            number = train.prs[-1]
            pr = self.host.pr(number)
            tested = self.git.rev(f"{train.sha}^2")
            why = ""
            if pr.head_sha != tested:
                why = f"its head moved to {pr.head_sha[:12]} after the train tested {tested[:12]}"
            elif self.s.label("queue_label") not in pr.labels:
                why = "it left the queue while its train ran"
            elif self.s.label("hold_label") in pr.labels:
                why = f"it was put on hold ({self.s.label('hold_label')}) while its train ran"
            elif self.host.pr_state(number) != "open":
                why = "it is no longer open"
            if why:
                self.report.say(f"PR #{number}: not landed — {why}; the trains from {train.index} on are discarded")
                return position
        return len(states)

    def land(  # noqa: C901 — push, bookkeeping, culprit, clean-up, each guarded
        self, batch: str, states: List[Tuple[Train, str, str]], trunk: str, landed_upto: int = 0
    ) -> bool:
        """Land the longest green prefix, record it, blame the culprit. False when the bookkeeping of a landing
        could not be completed: the trains then STAY, and the next tick completes it before anything else."""
        trains = [t for t, _s, _u in states]
        green = 0
        for _train, state, _url in states:
            if state != "success":
                break
            green += 1
        blame = green < len(states)
        if landed_upto:
            green, blame = landed_upto, blame and green == landed_upto
        else:
            landable = self._still_landable(states[:green])
            if landable < green:
                green, blame = landable, False
        if green:
            target = states[green - 1][0]
            if not landed_upto:
                if not self.git.is_ancestor(trunk, target.sha):
                    self.report.say(f"batch {batch}: train {green} does not descend from the trunk — abandoned")
                    self.delete_trains(trains)
                    return True
                self.report.say(f"land {target.sha[:12]} on {self.s.trunk} (train {green} of batch {batch})")
                if not self.dry:
                    result = self.git.run("push", self.s.remote, f"{target.sha}:refs/heads/{self.s.trunk}", check=False)
                    if result.returncode != 0:
                        self.report.say(
                            f"the fast-forward was refused ({result.stderr.strip()[:300]}) — nothing landed"
                        )
                        self.delete_trains(trains)
                        return True
            urls = {train.prs[-1]: url for train, _state, url in states[:green] if train.prs}
            failures = []
            for number in target.prs:
                try:
                    self.after_landing(number, target.sha, urls.get(number, ""))
                except HostError as exc:
                    failures.append(f"PR #{number}: {exc}")
            if failures:
                self.report.say(
                    "the landing is on the trunk, but its records are incomplete — the trains stay and the next "
                    "tick completes them: " + "; ".join(failures)
                )
                return False
            self.after_batch_landed(target.sha)
        if blame:
            culprit_train, state, url = states[green]
            if culprit_train.prs:
                self.after_red_train(
                    culprit_train.prs[-1], url, errored=state in ("error", "cancelled"), train_sha=culprit_train.sha
                )
        self.delete_trains(trains)
        return True

    def after_landing(self, number: int, sha: str, train_url: str) -> None:
        """Every record of one landed PR. Idempotent: a tick that completes an interrupted landing repeats it."""
        pr = self.host.pr(number)
        line = f"merge-steward: landed {sha} (PR #{number}, train run {train_url or 'n/a'})"
        recorded = any(f"merge-steward: landed {sha}" in text for text in self.host.pr_comment_texts(number))
        if not recorded:
            self._do(f"PR #{number}: comment landed", self.host.pr_comment, number, line)
        for label in (self.s.label("queue_label"), self.s.label("retried_label")):
            self._do(f"PR #{number}: -label {label}", self.host.pr_remove_label, number, label)
        if not self.dry and self._still_open(number):
            # The host marks a PR merged once its head is reachable from the trunk, a few seconds after the push;
            # when it has not after half a minute, the landing comment is the record and the PR is closed so
            # nothing reads it as open work. (`_still_landable` made sure the landed commit IS its head.)
            self._do(f"PR #{number}: close (landed by fast-forward)", self.host.pr_close, number)
        self.record_issue_landings(pr, line, sha, train_url)

    def _still_open(self, number: int, checks: int = 6, interval: float = 5.0) -> bool:
        for attempt in range(checks):
            if self.host.pr_state(number) != "open":
                return False
            if attempt + 1 < checks:
                time.sleep(interval)
        return True

    def record_issue_landings(self, pr: PullRequest, line: str, sha: str, run_url: str) -> None:
        """The landing line on every issue the PR references, then the verification path the mode selects.
        Idempotent, and an issue number that does not exist is skipped rather than retried forever."""
        for number in pr.issues:
            try:
                issue = self.host.issue(number)
            except HostError as exc:
                if exc.status == 404:
                    self.report.say(f"issue #{number}: does not exist — no landing recorded on it")
                    continue
                raise
            if not any(f"merge-steward: landed {sha} (PR #{pr.number}" in text for text in issue.comments):
                self._do(f"issue #{number}: landing line", self.host.issue_comment, number, line)
                issue.comments.append(line)
            if self.s.verification == "watcher":
                self._issue_labels(number, add=[self.s.label("awaiting_label")])
            elif self.s.verification == "none":
                self._queued_refs = None  # the queue changes during a landing: read it fresh for each issue
                pending = self._prs_in_flight(issue, exclude=[pr.number])
                if pending:
                    self.report.say(f"issue #{number}: {pending} still in flight — verified when the last lands")
                    continue
                self.verify_issue(number, sha, "success", run_url, "trunk (no deploy)", issue)

    def record_landing(self, number: int) -> int:
        """Direct-merge mode: record a PR the worker merged itself, so the watcher verifies its issues too."""
        sha = self.host.merge_commit(number)
        if not sha:
            self.report.say(f"PR #{number} is not merged — nothing to record")
            return EXIT_REFUSED
        pr = self.host.pr(number)
        line = f"merge-steward: landed {sha} (PR #{number}, direct merge)"
        self._do(f"PR #{number}: comment landed", self.host.pr_comment, number, line)
        self.record_issue_landings(pr, line, sha, pr.url)
        return EXIT_OK

    def after_batch_landed(self, sha: str) -> None:
        if self.s.verification == "watcher":
            self._do(f"start the deploy of {sha[:12]}", self.host.trigger_deploy, sha)

    def after_red_train(self, number: int, url: str, errored: bool = False, train_sha: str = "") -> None:
        """The culprit of a red train — or of a train whose CI never ran to a result (`errored`: no run, cancelled,
        timed out). A red train is retried once when `retry_culprit_once`; an errored one always once (the
        runner, not the change, is the usual cause), and blamed the second time — a change that keeps its train
        from running (a CI workflow it broke) must not wedge the queue."""
        mark = CULPRIT_MARK.format(sha=train_sha) if train_sha else ""
        if mark and any(mark in text for text in self.host.pr_comment_texts(number)):
            return  # an interrupted tick already judged this train
        pr = self.host.pr(number)
        allowed = errored or bool(self.s.steward["retry_culprit_once"])
        retry = allowed and self.s.label("retried_label") not in pr.labels
        what = (
            f"the train with this PR could not run its CI to a result (no run, cancelled or timed out: "
            f"{url or 'no run link'})"
            if errored
            else f"the train with this PR failed ({url or 'no run link'})"
        )
        if retry:
            self._do(
                f"PR #{number}: +label {self.s.label('retried_label')}",
                self.host.pr_add_labels,
                number,
                [self.s.label("retried_label")],
            )
            self._do(
                f"PR #{number}: comment (re-queued once)",
                self.host.pr_comment,
                number,
                f"merge-steward: {what}. It stays queued for ONE retry, because its own CI was green and a flaky "
                f"suite or runner must not bounce a good change; a second failure takes it out of the queue. "
                f"{RETRY_MARK} {mark}",
            )
            return
        for label in (self.s.label("queue_label"), self.s.label("retried_label")):
            self._do(f"PR #{number}: -label {label}", self.host.pr_remove_label, number, label)
        self._do(
            f"PR #{number}: +label {self.s.label('failed_label')}",
            self.host.pr_add_labels,
            number,
            [self.s.label("failed_label")],
        )
        link = url or "no run link"
        if errored:
            text = (
                f"merge-steward: this PR left the queue — its train could not run CI to a result twice ({link}). "
                f"The PRs ahead of it landed without it. Check that the change keeps the CI workflow "
                f"startable on a branch (`workflow_dispatch` on GitHub) and within `train_timeout_minutes`, push "
                f"once, and enqueue again when the PR's own CI is green."
            )
        else:
            text = (
                f"merge-steward: this PR left the queue — CI failed on the train that added it to the trunk and the "
                f"PRs ahead of it ({link}). The PRs ahead of it landed without it. Read every failing job, fix "
                f"them all, push once, and enqueue again when the PR's own CI is green."
            )
        self._do(f"PR #{number}: comment (left the queue)", self.host.pr_comment, number, f"{text} {mark}".strip())
        for issue in pr.issues:
            self._return_issue(
                issue, self.s.label("rework_label"), f"merge-steward: PR #{number} left the queue — {text}"
            )

    # -- 3. plan --------------------------------------------------------------------------------------
    def eligibility(  # noqa: C901 — one test per admission rule, in the order the docstring lists them
        self, pr: PullRequest, landed: Sequence[int], ahead: Sequence[int], closed: Sequence[int] = ()
    ) -> Tuple[str, str]:
        """('eligible' | 'wait' | 'reject', why)."""
        st = self.s.steward
        if pr.base_ref != self.s.trunk:
            return "reject", f"its base is {pr.base_ref!r}, not the trunk {self.s.trunk!r}"
        if pr.draft:
            return "reject", "it is a draft"
        if self.s.label("hold_label") in pr.labels:
            return "wait", f"it carries {self.s.label('hold_label')}"
        if self.s.verification == "watcher" and pr.closing_text:
            refs = ", ".join(f"#{n}" for n in pr.closing_issues)
            return "reject", (
                f"its description would make the host CLOSE {refs} at landing, before the deploy check "
                f"(`{pr.closing_text[:120]}`). Write `Refs {refs}` instead"
            )
        for dependency in pr.depends:
            if dependency in closed:
                return "reject", f"it depends on #{dependency}, which was closed without landing"
            if dependency not in landed and dependency not in ahead:
                return "wait", f"it depends on #{dependency}, which has not landed"
        if st["require_pr_ci"]:
            ci = self.host.head_ci(pr)
            if ci == "failure":
                return "reject", f"its own CI is red on its head {pr.head_sha[:12]}"
            if ci == "pending":
                return "wait", f"its own CI is still running on {pr.head_sha[:12]}"
            if ci == "none":
                return "wait", f"no CI has reported on its head {pr.head_sha[:12]}"
        if st["require_approval"] and not self.host.pr_approved(pr):
            return "wait", "it is not approved"
        return "eligible", ""

    def plan(self, trunk: str) -> List[Train]:
        queued = sorted(self.host.queued_prs(self.s.label("queue_label")), key=lambda p: (p.enqueued_at, p.number))
        if not queued:
            self.report.say("queue empty")
            return []
        chosen: List[PullRequest] = []
        footprint: set = set()
        deferred = 0
        for pr in queued:
            if len(chosen) >= self.s.batch_size:
                break
            landed, closed = self._dependencies(pr)
            verdict, why = self.eligibility(pr, landed, [p.number for p in chosen], closed)
            if verdict == "reject":
                self.reject(pr, self.s.label("failed_label"), f"the queue cannot take it: {why}.")
                continue
            if verdict == "wait":
                self.report.say(f"PR #{pr.number}: waits — {why}")
                continue
            files = set(self.host.pr_files(pr.number))
            if chosen and files & footprint:
                deferred += 1
                self.report.say(f"PR #{pr.number}: deferred to the next batch — its files overlap the batch")
                continue
            chosen.append(pr)
            footprint |= files
        if not chosen:
            self.report.say("no eligible PR this round" + (f" ({deferred} deferred)" if deferred else ""))
            return []
        return self.build(trunk, chosen)

    def dependency_state(self, number: int) -> str:
        """`landed` / `closed` / `open` / `unknown` for the PR a `Depends-on:` names. Landed is judged by the host
        AND by ancestry (the PR's head on the trunk), so a dependency the steward landed and then closed counts;
        a number the host does not know is `unknown` (the dependent waits, with the reason in `status`)."""
        try:
            state = self.host.pr_state(number)
            if state == "merged":
                return "landed"
            head = self.host.pr(number).head_sha
        except HostError:
            return "unknown"
        if head and self.git.has_commit(head) and self.git.is_ancestor(head, self.trunk_ref):
            return "landed"
        return "closed" if state == "closed" else "open"

    def _dependencies(self, pr: PullRequest) -> Tuple[List[int], List[int]]:
        states = {number: self.dependency_state(number) for number in pr.depends}
        return [n for n, s in states.items() if s == "landed"], [n for n, s in states.items() if s == "closed"]

    def reject(self, pr: PullRequest, label: str, why: str) -> None:
        for old in (self.s.label("queue_label"), self.s.label("retried_label")):
            self._do(f"PR #{pr.number}: -label {old}", self.host.pr_remove_label, pr.number, old)
        self._do(f"PR #{pr.number}: +label {label}", self.host.pr_add_labels, pr.number, [label])
        self._do(f"PR #{pr.number}: comment (left the queue)", self.host.pr_comment, pr.number, f"merge-steward: {why}")
        for issue in pr.issues:
            self._return_issue(
                issue, self.s.label("rework_label"), f"merge-steward: PR #{pr.number} left the queue — {why}"
            )

    def _fresh_batch(self, trunk: str) -> str:
        """A batch id no train of this repository carries: the UTC second plus the trunk prefix, and never one
        already used. Two builds in one second — a culprit's retry rebuilt in the same tick on a fast runner —
        would otherwise produce the same branches and byte-identical commits, and the first train's culprit mark
        would then read as "already judged", leaving a twice-red PR in the queue. So the id waits for the next
        second instead (the train trailers carry it, which makes every train commit distinct)."""
        taken = set(self._batches) | set(self.trains_in_flight())
        while True:
            batch = utcnow().strftime("%Y%m%d%H%M%S") + trunk[:7]
            if batch not in taken:
                self._batches.add(batch)
                return batch
            time.sleep(0.25)

    def build(self, trunk: str, chosen: List[PullRequest]) -> List[Train]:
        batch = self._fresh_batch(trunk)
        prefix = str(self.s.steward["train_prefix"])
        refspecs = [self.host.pr_head_refspec(pr.number) for pr in chosen]
        self.git.run("fetch", "--no-auto-gc", self.s.remote, *refspecs)
        scratch = Path(tempfile.mkdtemp(prefix="steward-train-"))
        trains: List[Train] = []
        in_batch = {pr.number for pr in chosen}
        try:
            self.git.run("worktree", "add", "--detach", str(scratch), trunk)
            work = Git(scratch, str(self.s.steward["git_user_name"]), str(self.s.steward["git_user_email"]))
            try:
                landed_prs: List[int] = []
                for pr in chosen:
                    head = work.rev(f"refs/steward/pr/{pr.number}")
                    if head != pr.head_sha:
                        self.report.say(f"PR #{pr.number}: its head moved to {head[:12]} after CI — waits for CI on it")
                        continue
                    dropped = [d for d in pr.depends if d in in_batch and d not in landed_prs]
                    if dropped:
                        self.report.say(
                            f"PR #{pr.number}: waits — its dependency {', '.join(f'#{d}' for d in dropped)} "
                            "dropped out of this batch"
                        )
                        continue
                    if self.s.verification == "watcher":
                        found = closing_line(self.git.out("log", "--format=%B", f"{trunk}..{head}"))
                        if found:
                            self.reject(
                                pr,
                                self.s.label("failed_label"),
                                f"the queue cannot take it: a commit message on it would make the host close an "
                                f"issue when it lands, before the deploy check (`{found[:120]}`). Reword that "
                                f"commit (`Refs #N`), push once, and enqueue again when its CI is green.",
                            )
                            continue
                    prs_after = landed_prs + [pr.number]
                    # No PR title in the message: a title such as "Fix #45: ..." would close #45 at landing.
                    message = (
                        f"Merge PR #{pr.number} (merge steward)\n\n"
                        f"Steward-PR: #{pr.number}\n"
                        f"Steward-PRs: {' '.join(f'#{n}' for n in prs_after)}\n"
                        f"Steward-Issues: {' '.join(f'#{n}' for n in pr.issues) or 'none'}\n"
                        f"Steward-Batch: {batch}\n"
                        f"Steward-Base: {trunk}\n"
                    )
                    ok, conflicted = work.merge(pr.head_sha, message)
                    if not ok:
                        self.reject(
                            pr,
                            self.s.label("conflict_label"),
                            "it conflicts with the trunk or with the PRs queued ahead of it in "
                            + ", ".join(f"`{path}`" for path in conflicted[:20])
                            + ". Integrate the trunk (conflicts go to code-merge-reviewer), push once, and enqueue "
                            "again when its CI is green.",
                        )
                        continue
                    landed_prs.append(pr.number)
                    sha = work.rev("HEAD")
                    trains.append(
                        Train(batch, len(trains) + 1, f"{prefix}{batch}-{len(trains) + 1}", sha, list(prs_after), trunk)
                    )
            finally:
                work.close()
        finally:
            self.git.run("worktree", "remove", "--force", str(scratch), check=False)
            shutil.rmtree(scratch, ignore_errors=True)
        if not trains:
            return []
        if not self.s.steward["parallel_trains"]:
            trains = trains[-1:]
        pushes = [f"{t.sha}:refs/heads/{t.branch}" for t in trains]
        self._do(f"push trains {', '.join(t.branch for t in trains)}", self.git.run, "push", self.s.remote, *pushes)
        for train in trains:
            self._start_ci(train, f"start CI (PRs {' '.join(f'#{n}' for n in train.prs)})")
        return trains

    # -- the tick -------------------------------------------------------------------------------------
    def tick(self) -> int:
        trunk = self.fetch()
        self.report.say(f"trunk {self.s.trunk} at {trunk[:12]}")
        self.reverify(trunk)
        if self.s.merge != "steward":
            # The scheduled tick also runs while a project merges directly — the bootstrap PR that installs this
            # workflow lands before config/delivery.json says "steward", and a direct + watcher project still
            # needs `reverify`. It lands nothing and plans nothing, and it is green.
            self.report.say(f"merge is {self.s.merge!r}: the queue is off — nothing to land or plan")
            return EXIT_OK
        if self.finish(trunk):
            return EXIT_OK
        trunk = self.fetch()
        self.plan(trunk)
        return EXIT_OK

    # -- verdict --------------------------------------------------------------------------------------
    def verdict(self, sha: str, conclusion: str, run_url: str, environment: str) -> int:
        self.fetch()
        if not self.git.has_commit(sha):
            self.git.run("fetch", "--no-auto-gc", self.s.remote, sha, check=False)
        if not self.git.has_commit(sha):
            self.report.say(f"the deployed commit {sha} is not in this clone — no verdict")
            return EXIT_ERROR
        candidates = set(self.host.issues_with_label(self.s.label("awaiting_label")))
        candidates |= set(self.host.issues_with_label(self.s.label("verification_failed_label")))
        if not candidates:
            self.report.say("no issue awaits verification")
            return EXIT_OK
        self._queued_refs = None
        for number in sorted(candidates):
            issue = self.host.issue(number)
            landing = last_landing(issue.comments)
            if landing is None:
                self.report.say(f"issue #{number}: no landing line — skipped")
                continue
            pending = self._prs_in_flight(issue)
            if pending:
                self.report.say(f"issue #{number}: {pending} still in flight — verified once every PR has landed")
                continue
            if not self.git.has_commit(landing) or not self.git.is_ancestor(landing, sha):
                self.report.say(
                    f"issue #{number}: landed {landing[:12]}, not contained in {sha[:12]} — not covered yet"
                )
                continue
            self.verify_issue(number, sha, conclusion, run_url, environment, issue)
        return EXIT_OK

    def _prs_in_flight(self, issue: Issue, exclude: Iterable[int] = ()) -> str:
        """The PRs of this issue that have NOT landed yet, as text ("" when none): every PR its hand-off note
        queued (`merge-steward: queued PR #n`) that is still open, and every queued PR that references it. An
        issue delivered by two PRs is verified only when the second has landed too."""
        if self._queued_refs is None:
            self._queued_refs = {}
            for pr in self.host.queued_prs(self.s.label("queue_label")):
                for number in pr.issues:
                    self._queued_refs.setdefault(number, set()).add(pr.number)
        skip = set(exclude)
        waiting = set(self._queued_refs.get(issue.number, set())) - skip
        for text in issue.comments:
            for found in QUEUED_RE.findall(text or ""):
                if int(found) in skip or int(found) in waiting:
                    continue
                try:
                    if self.host.pr_state(int(found)) == "open":
                        waiting.add(int(found))
                except HostError:
                    continue
        return ", ".join(f"PR #{n}" for n in sorted(waiting))

    def verify_issue(
        self, number: int, sha: str, conclusion: str, run_url: str, environment: str, issue: Optional[Issue] = None
    ) -> None:
        """Render one verdict. The marked COMMENT comes first and the label that makes the issue a candidate
        (`awaiting-verification`) goes LAST, so an interrupted run leaves a candidate the next run completes:
        with the mark present it skips the comment and repeats only the idempotent label and close steps."""
        issue = issue or self.host.issue(number)
        mark = VERDICT_MARK.format(conclusion=conclusion, sha=sha)
        recorded = any(mark in comment for comment in issue.comments)
        labels = self.s.steward
        if (
            recorded
            and labels["awaiting_label"] not in issue.labels
            and (conclusion != "success" or issue.state != "open")
        ):
            self.report.say(f"issue #{number}: verdict for {sha[:12]} already recorded")
            return
        if conclusion != "success":
            if labels["verification_failed_label"] in issue.labels and labels["awaiting_label"] not in issue.labels:
                return  # already returned on an earlier red deploy; the next green one verifies it
            if not recorded:
                self._do(
                    f"issue #{number}: comment (verification failed)",
                    self.host.issue_comment,
                    number,
                    f"merge-steward: the post-deploy check FAILED on `{sha[:12]}` ({environment}; "
                    f"{run_url or 'no run link'}), a deploy that contains this issue's landing. Every issue landed "
                    f"since the last green deploy is a suspect; this one stays open until a green deploy contains "
                    f"its landing. {mark}",
                )
            self._issue_labels(number, add=[labels["verification_failed_label"], labels["rework_label"]])
            self._do(
                f"issue #{number}: release claim", self.host.issue_release_claim, number, labels["in_progress_label"]
            )
            self._issue_labels(number, remove=[labels["awaiting_label"]])
            return
        body, ticked_now = tick_post_deploy_items(issue.body)
        if ticked_now:
            self._do(f"issue #{number}: tick {ticked_now} post-deploy item(s)", self.host.issue_set_body, number, body)
        ticked, total, open_items = checklist_counts(body)
        started = claim_started(issue.comments)
        lines = [
            f"merge-steward: verified — the post-deploy check passed on `{sha[:12]}` ({environment}; "
            f"{run_url or 'no run link'}), which contains this issue's landing.",
            f"Checklist: {ticked}/{total} ticked. "
            f"Time spent (claim to verification): {elapsed_text(started, utcnow())}.",
        ]
        done_labels = [labels["awaiting_label"], labels["verification_failed_label"], labels["rework_label"]]
        if open_items:
            lines.append(
                "Left OPEN for a session to finish (the watcher closes only a complete checklist): "
                + "; ".join(item[:80] for item in open_items[:10])
            )
            if not recorded:
                self._do(
                    f"issue #{number}: comment (verified, items open)",
                    self.host.issue_comment,
                    number,
                    "\n".join(lines + [mark]),
                )
            self._issue_labels(number, add=[labels["verified_label"], labels["closeout_label"]])
            self._do(
                f"issue #{number}: release claim", self.host.issue_release_claim, number, labels["in_progress_label"]
            )
            self._issue_labels(number, remove=done_labels)
            return
        if not recorded:
            self._do(
                f"issue #{number}: comment (verified, closing)",
                self.host.issue_comment,
                number,
                "\n".join(lines + [mark]),
            )
        self._issue_labels(number, add=[labels["verified_label"]])
        self._do(f"issue #{number}: release claim", self.host.issue_release_claim, number, labels["in_progress_label"])
        self._do(f"issue #{number}: close", self.host.issue_close, number)
        self._issue_labels(number, remove=done_labels)

    def deploy_guard(self, event_file: str) -> int:
        """The GitHub deploy's first job: the commit it is asked to deploy is a 40-hex commit ON the trunk. Runs
        the default branch's copy of this file, so a dispatch can never make the guard run the commit it guards."""
        sha = deployed_sha(read_event(event_file))
        trunk = self.fetch()
        if self.git.has_commit(sha) and (sha == trunk or self.git.is_ancestor(sha, self.trunk_ref)):
            self.report.say(f"deploying {sha} from {self.s.trunk} (at {trunk[:12]})")
            return EXIT_OK
        self.report.say(f"REFUSED: {sha} is not a commit on {self.s.trunk} — nothing is deployed, no verdict follows")
        return EXIT_REFUSED

    # -- agent-facing ---------------------------------------------------------------------------------
    def check(self, number: int, allow_pending: bool = False) -> Tuple[bool, str]:
        pr = self.host.pr(number)
        landed, closed = self._dependencies(pr)
        verdict, why = self.eligibility(pr, landed, pr.depends, closed)  # dependencies may still be queued ahead
        if verdict == "eligible" or (allow_pending and verdict == "wait"):
            return True, why or "eligible"
        return False, why

    def enqueue(self, number: int, allow_pending: bool) -> int:
        ok, why = self.check(number, allow_pending)
        if not ok:
            self.report.say(f"PR #{number} NOT queued: {why}")
            return EXIT_REFUSED
        self._do(
            f"PR #{number}: +label {self.s.label('queue_label')}",
            self.host.pr_add_labels,
            number,
            [self.s.label("queue_label")],
        )
        self._do(f"PR #{number}: comment", self.host.pr_comment, number, QUEUED_LINE.format(pr=number))
        try:
            self._do("trigger a steward tick", self.host.trigger_tick)
        except HostError as exc:  # the schedule picks it up anyway; a failed trigger only delays it
            self.report.say(f"the tick trigger failed ({exc}); the scheduled tick will pick the PR up")
        self.report.say(f"PR #{number} queued ({why})")
        return EXIT_OK

    def dequeue(self, number: int, reason: str) -> int:
        self._do(
            f"PR #{number}: -label {self.s.label('queue_label')}",
            self.host.pr_remove_label,
            number,
            self.s.label("queue_label"),
        )
        self._do(f"PR #{number}: comment", self.host.pr_comment, number, f"merge-steward: dequeued — {reason}")
        return EXIT_OK

    def status(self, as_json: bool) -> int:
        trunk = self.fetch()
        queued = sorted(self.host.queued_prs(self.s.label("queue_label")), key=lambda p: (p.enqueued_at, p.number))
        rows = []
        for pr in queued:
            landed, closed = self._dependencies(pr)
            verdict, why = self.eligibility(pr, landed, [], closed)
            rows.append({"pr": pr.number, "state": verdict, "why": why, "enqueued_at": pr.enqueued_at})
        batches = {
            batch: [
                {"train": t.index, "branch": t.branch, "prs": t.prs, "ci": self.host.ci_state(t.branch, t.sha)[0]}
                for t in trains
            ]
            for batch, trains in self.trains_in_flight().items()
        }
        awaiting = self.host.issues_with_label(self.s.label("awaiting_label"))
        data = {"trunk": trunk, "queue": rows, "batches": batches, "awaiting_verification": awaiting}
        if as_json:
            print(json.dumps(data, indent=2))
        else:
            print(
                f"trunk {self.s.trunk} {trunk[:12]}; {len(rows)} queued; {len(batches)} batch(es) in flight; "
                f"{len(awaiting)} issue(s) awaiting verification"
            )
            for row in rows:
                print(f"  PR #{row['pr']}: {row['state']}{' — ' + row['why'] if row['why'] else ''}")
            for batch, trains in batches.items():
                print(f"  batch {batch}: " + ", ".join(f"train {t['train']} {t['ci']}" for t in trains))
        return EXIT_OK


# ---------------------------------------------------------------------------------------------- CLI


def read_token(args: argparse.Namespace, settings: Settings) -> str:
    if args.token_stdin:
        token = sys.stdin.readline().strip()
    elif args.token_file:
        token = Path(args.token_file).read_text(encoding="utf-8").strip()
    elif settings.host == "github":
        path = ROOT / "credentials" / "github-pat.txt"
        token = path.read_text(encoding="utf-8").strip() if path.is_file() else ""
    else:
        path = ROOT / "config" / "gitlab.json"
        token = ""
        if path.is_file():
            ignored = Git(ROOT, "x", "x")
            try:
                tracked = ignored.run("check-ignore", "-q", str(path), check=False).returncode != 0
            finally:
                ignored.close()
            if tracked:
                raise ConfigError(
                    f"{path} is not ignored by git, so it must not hold a token: pass the token with --token-stdin "
                    "(the wrapper's delivery verbs do) or --token-file"
                )
            token = str(json.loads(path.read_text(encoding="utf-8")).get("token", ""))
    if not token or "PASTE" in token:
        raise ConfigError("no token: pass --token-stdin / --token-file, or fill the wrapper's credential file")
    return token


class _NoHost:
    """The host of a command that needs none (`deploy-guard`): any tracker call is a programming error."""

    def __getattr__(self, name: str) -> Any:
        raise ConfigError(f"deploy-guard reached the tracker ({name}) — it must use git only")


NO_HOST: Any = _NoHost()


def make_host(settings: Settings, token: str, git: Git) -> HostAPI:
    cookies = str(settings.steward["cookie_file"])
    if cookies:
        path = Path(cookies).expanduser()
        path = path if path.is_absolute() else ROOT / path
        use_cookie_file(path)
        git.extra += ["-c", f"http.cookieFile={path.as_posix()}"]
    if settings.host == "github":
        return GitHubAPI(token, settings, git)
    # The GitLab job token cannot push: the steward's project access token goes to git as an HTTP header.
    basic = base64.b64encode(f"oauth2:{token}".encode("utf-8")).decode("ascii")
    git.use_http_header(f"Authorization: Basic {basic}")
    return GitLabAPI(token, settings, git)


def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="merge_steward.py", description=__doc__.split("\n\n")[0])
    parser.add_argument("--config", default=str(CONFIG_PATH))
    source = parser.add_mutually_exclusive_group()
    source.add_argument("--token-stdin", action="store_true", help="read the API token from the first stdin line")
    source.add_argument("--token-file", help="read the API token from this file")
    sub = parser.add_subparsers(dest="command", required=True)
    tick = sub.add_parser("tick")
    tick.add_argument("--run-url", default="")
    tick.add_argument("--dry-run", action="store_true")
    verdict = sub.add_parser("verdict")
    which = verdict.add_mutually_exclusive_group(required=True)
    which.add_argument("--sha")
    which.add_argument("--sha-from-event", metavar="FILE", help="read the deployed commit from a GitHub event file")
    verdict.add_argument("--conclusion", required=True, choices=("success", "failure", "auto"))
    verdict.add_argument("--run-url", default="")
    verdict.add_argument("--environment", default="dev")
    verdict.add_argument("--gitlab-pipeline", default="")
    verdict.add_argument("--deploy-jobs", default="")
    verdict.add_argument("--dry-run", action="store_true")
    for name in ("enqueue", "check-pr"):
        cmd = sub.add_parser(name)
        cmd.add_argument("pr", type=int)
        cmd.add_argument("--allow-pending", action="store_true")
        cmd.add_argument("--dry-run", action="store_true")
    dequeue = sub.add_parser("dequeue")
    dequeue.add_argument("pr", type=int)
    dequeue.add_argument("--reason", default="taken out of the queue by its author")
    dequeue.add_argument("--dry-run", action="store_true")
    record = sub.add_parser("record-landing")
    record.add_argument("pr", type=int)
    record.add_argument("--dry-run", action="store_true")
    status = sub.add_parser("status")
    status.add_argument("--json", action="store_true")
    guard = sub.add_parser("deploy-guard")
    guard.add_argument("--event-file", required=True)
    return parser.parse_args(list(argv))


def main(argv: Sequence[str]) -> int:  # noqa: C901 — one dispatch per subcommand
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8", errors="replace")  # type: ignore[union-attr]
        except (AttributeError, ValueError):
            pass
    args = parse_args(argv)
    try:
        settings = load_settings(Path(args.config))
    except ConfigError as exc:
        print(f"merge_steward: {exc}", file=sys.stderr)
        return EXIT_USAGE
    if settings.merge != "steward" and args.command == "enqueue":
        print(
            f"merge_steward: config/delivery.json says merge={settings.merge!r}; the steward is not this project's "
            "merge path (set merge to 'steward' to enable it)",
            file=sys.stderr,
        )
        return EXIT_USAGE
    git = Git(ROOT, str(settings.steward["git_user_name"]), str(settings.steward["git_user_email"]))
    try:
        if args.command == "deploy-guard":  # git only: no token, no tracker
            return Steward(settings, git, NO_HOST, Report()).deploy_guard(args.event_file)
        token = read_token(args, settings)
        host = make_host(settings, token, git)
        report = Report(dry_run=bool(getattr(args, "dry_run", False)))
        steward = Steward(settings, git, host, report, getattr(args, "run_url", ""))
        if args.command == "tick":
            return steward.tick()
        if args.command == "verdict":
            conclusion = args.conclusion
            if conclusion == "auto":
                conclusion = host.deploy_conclusion(args.gitlab_pipeline, args.deploy_jobs.split(","))
                if conclusion == "none":
                    report.say("no verdict: the deploy did not run to a result (superseded, cancelled or skipped)")
                    return EXIT_OK
            sha = args.sha or deployed_sha(read_event(args.sha_from_event))
            return steward.verdict(sha, conclusion, args.run_url, args.environment)
        if args.command == "enqueue":
            return steward.enqueue(args.pr, args.allow_pending)
        if args.command == "check-pr":
            ok, why = steward.check(args.pr, args.allow_pending)
            print(("acceptable: " if ok else "NOT acceptable: ") + why)
            return EXIT_OK if ok else EXIT_REFUSED
        if args.command == "dequeue":
            return steward.dequeue(args.pr, args.reason)
        if args.command == "record-landing":
            return steward.record_landing(args.pr)
        return steward.status(args.json)
    except ConfigError as exc:
        print(f"merge_steward: {exc}", file=sys.stderr)
        return EXIT_USAGE
    except (GitError, HostError, OSError) as exc:
        print(f"merge_steward: {exc}", file=sys.stderr)
        return EXIT_ERROR
    finally:
        git.close()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
