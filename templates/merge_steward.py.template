# ---------------------------------------------------------------------------------------------- HTTP


class HostError(RuntimeError):
    def __init__(self, message: str, status: int = 0) -> None:
        super().__init__(message)
        self.status = status


_OPENER: Optional[OpenerDirector] = None


def use_cookie_file(path: Path) -> None:
    """Send the cookies of a Netscape cookie file with every API request (an authenticating proxy in front of the
    host). The file is read, never written; its path is configuration, its content a secret kept out of git."""
    global _OPENER
    jar = MozillaCookieJar(str(path))
    try:
        jar.load(ignore_discard=True, ignore_expires=True)
    except OSError as exc:
        raise ConfigError(f"cannot read the cookie file {path} ({exc})") from exc
    _OPENER = build_opener(HTTPCookieProcessor(jar))


def http_json(method: str, url: str, headers: Dict[str, str], payload: Any = None, attempts: int = 3) -> Any:
    """One JSON request with a short retry on 5xx and connection errors. 404 on a DELETE is success. An answer
    that is not JSON — an authenticating proxy's sign-in page — is a host error, never a crash."""
    body = json.dumps(payload).encode("utf-8") if payload is not None else None
    last: Optional[Exception] = None
    for attempt in range(attempts):
        request = Request(url=url, data=body, method=method)
        for key, value in headers.items():
            request.add_header(key, value)
        if body is not None:
            request.add_header("Content-Type", "application/json")
        try:
            opened = _OPENER.open(request, timeout=30) if _OPENER else urlopen(request, timeout=30)  # nosec B310
            with opened as response:
                text = response.read().decode("utf-8", errors="replace")
                kind = str(response.headers.get("Content-Type") or "")
            try:
                return json.loads(text) if text.strip() else {}
            except ValueError as exc:
                raise HostError(
                    f"{method} {url} answered {kind or 'a non-JSON body'}, not JSON ({text.strip()[:80]!r}) — an "
                    "authenticating proxy's sign-in page? Set steward.cookie_file in config/delivery.json"
                ) from exc
        except HTTPError as exc:
            if method == "DELETE" and exc.code == 404:
                return {}
            detail = exc.read().decode("utf-8", errors="replace")[:500]
            last = HostError(f"{method} {url} -> {exc.code}: {detail}", exc.code)
            if exc.code < 500:
                raise last from exc
        except (URLError, TimeoutError, ConnectionError) as exc:
            last = HostError(f"{method} {url} -> {exc}")
        if attempt + 1 < attempts:
            time.sleep(2 * (attempt + 1))
    raise last if last else HostError(f"{method} {url} failed")


def remote_url(git: Git, remote: str) -> str:
    return git.out("remote", "get-url", remote)


def github_api_root(web: str) -> str:
    """The REST root of a GitHub host, from its web origin: `api.<host>` for github.com, `<host>/api/v3` for a
    GitHub Enterprise Server. Derived, so no API host is a literal of this file."""
    host = urllib.parse.urlsplit(web).hostname or ""
    return f"https://api.{host}" if host == "github.com" else f"{web.rstrip('/')}/api/v3"


def redact(url: str) -> str:
    """`url` without any user or password part — a CI clone URL carries the job token there."""
    parts = urllib.parse.urlsplit(url)
    if parts.scheme and (parts.username or parts.password):
        netloc = (parts.hostname or "") + (f":{parts.port}" if parts.port else "")
        return urllib.parse.urlunsplit(parts._replace(netloc=netloc))
    return re.sub(r"^[^@/:]+@", "", url) if "://" not in url else url


def host_and_path(url: str) -> Optional[Tuple[str, str]]:
    """(`https://<host>[:port]`, `group/project`) from an https, ssh or scp-like remote URL — credentials dropped."""
    if "://" in url:
        parts = urllib.parse.urlsplit(url)
        if not parts.hostname:
            return None
        web = parts.scheme in ("http", "https")
        base = f"{parts.scheme if web else 'https'}://{parts.hostname}" + (
            f":{parts.port}" if web and parts.port else ""
        )
        path = parts.path
    else:
        match = re.match(r"^(?:[^@/]+@)?([^:/]+):(.+)$", url)
        if not match:
            return None
        base, path = f"https://{match.group(1)}", match.group(2)
    path = re.sub(r"\.git$", "", path.strip("/"))
    return (base, path) if path else None


class GitHubAPI:
    def __init__(self, token: str, settings: Settings, git: Git) -> None:
        url = remote_url(git, settings.remote)
        parsed = host_and_path(url)
        if not parsed or parsed[1].count("/") != 1:
            raise ConfigError(f"cannot read owner/repo from the remote URL {redact(url)!r}")
        self.repo = parsed[1]
        self.api = str(settings.steward["github_api"]).rstrip("/") or github_api_root(parsed[0])
        self.settings = settings
        self.headers = {
            "Authorization": f"Bearer {token}",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
        }

    def _call(self, method: str, path: str, payload: Any = None) -> Any:
        return http_json(method, f"{self.api}/repos/{self.repo}{path}", self.headers, payload)

    def _pages(self, path: str, key: Optional[str] = None, limit: int = 30) -> List[Any]:
        items: List[Any] = []
        joiner = "&" if "?" in path else "?"
        for page in range(1, limit + 1):
            data = self._call("GET", f"{path}{joiner}per_page=100&page={page}")
            chunk = data.get(key, []) if key else data
            items.extend(chunk)
            if len(chunk) < 100:
                break
        return items

    def _pull(self, data: Dict[str, Any], enqueued_at: str = "") -> PullRequest:
        return PullRequest(
            number=int(data["number"]),
            title=str(data.get("title") or ""),
            head_sha=str(data["head"]["sha"]),
            base_ref=str(data["base"]["ref"]),
            draft=bool(data.get("draft")),
            body=str(data.get("body") or ""),
            url=str(data.get("html_url") or ""),
            labels=[str(label["name"]) for label in data.get("labels", [])],
            enqueued_at=enqueued_at or str(data.get("created_at") or ""),
        )

    def queued_prs(self, label: str) -> List[PullRequest]:
        quoted = urllib.parse.quote(label)
        found = []
        for item in self._pages(f"/issues?state=open&labels={quoted}"):
            if "pull_request" not in item:
                continue
            number = int(item["number"])
            stamp = ""
            for event in self._pages(f"/issues/{number}/events", limit=10):
                if event.get("event") == "labeled" and (event.get("label") or {}).get("name") == label:
                    stamp = str(event.get("created_at") or stamp)
            found.append(self._pull(self._call("GET", f"/pulls/{number}"), stamp))
        return found

    def pr(self, number: int) -> PullRequest:
        return self._pull(self._call("GET", f"/pulls/{number}"))

    def pr_state(self, number: int) -> str:
        data = self._call("GET", f"/pulls/{number}")
        return "merged" if data.get("merged") else ("closed" if data.get("state") == "closed" else "open")

    def merge_commit(self, number: int) -> Optional[str]:
        data = self._call("GET", f"/pulls/{number}")
        return str(data["merge_commit_sha"]) if data.get("merged") and data.get("merge_commit_sha") else None

    def pr_files(self, number: int) -> List[str]:
        return [str(item["filename"]) for item in self._pages(f"/pulls/{number}/files")]

    def head_ci(self, pr: PullRequest) -> str:
        runs = self._pages(f"/commits/{pr.head_sha}/check-runs", key="check_runs", limit=5)
        status = self._call("GET", f"/commits/{pr.head_sha}/status")
        states = []
        for run in runs:
            if run.get("status") != "completed":
                states.append("pending")
            elif run.get("conclusion") in ("success", "neutral", "skipped"):
                states.append("success")
            else:
                states.append("failure")
        if int(status.get("total_count") or 0):
            combined = str(status.get("state"))
            states.append({"success": "success", "pending": "pending"}.get(combined, "failure"))
        if not states:
            return "none"
        if "failure" in states:
            return "failure"
        return "pending" if "pending" in states else "success"

    def pr_approved(self, pr: PullRequest) -> bool:
        latest: Dict[str, str] = {}
        for review in self._pages(f"/pulls/{pr.number}/reviews"):
            user = str((review.get("user") or {}).get("login") or "")
            if review.get("state") in ("APPROVED", "CHANGES_REQUESTED"):
                latest[user] = str(review["state"])
        return "APPROVED" in latest.values() and "CHANGES_REQUESTED" not in latest.values()

    def pr_head_refspec(self, number: int) -> str:
        return f"+refs/pull/{number}/head:refs/steward/pr/{number}"

    def pr_add_labels(self, number: int, labels: Sequence[str]) -> None:
        self._call("POST", f"/issues/{number}/labels", {"labels": list(labels)})

    def pr_remove_label(self, number: int, label: str) -> None:
        self._call("DELETE", f"/issues/{number}/labels/{urllib.parse.quote(label)}")

    def pr_comment(self, number: int, text: str) -> None:
        self._call("POST", f"/issues/{number}/comments", {"body": text})

    def pr_comment_texts(self, number: int) -> List[str]:
        return [str(c.get("body") or "") for c in self._pages(f"/issues/{number}/comments")]

    def pr_close(self, number: int) -> None:
        self._call("PATCH", f"/pulls/{number}", {"state": "closed"})

    def issue(self, number: int) -> Issue:
        data = self._call("GET", f"/issues/{number}")
        comments = [str(c.get("body") or "") for c in self._pages(f"/issues/{number}/comments")]
        return Issue(
            number=number,
            state="open" if data.get("state") == "open" else "closed",
            body=str(data.get("body") or ""),
            labels=[str(label["name"]) for label in data.get("labels", [])],
            comments=comments,
        )

    def issues_with_label(self, label: str) -> List[int]:
        items = self._pages(f"/issues?state=open&labels={urllib.parse.quote(label)}")
        return sorted(int(item["number"]) for item in items if "pull_request" not in item)

    issue_add_labels = pr_add_labels
    issue_remove_label = pr_remove_label
    issue_comment = pr_comment

    def issue_set_body(self, number: int, body: str) -> None:
        self._call("PATCH", f"/issues/{number}", {"body": body})

    def issue_close(self, number: int) -> None:
        self._call("PATCH", f"/issues/{number}", {"state": "closed", "state_reason": "completed"})

    def issue_release_claim(self, number: int, in_progress_label: str) -> None:
        data = self._call("GET", f"/issues/{number}")
        self.issue_remove_label(number, in_progress_label)
        logins = [str(a["login"]) for a in data.get("assignees", [])]
        if logins:
            self._call("DELETE", f"/issues/{number}/assignees", {"assignees": logins})

    def trigger_ci(self, branch: str) -> None:
        workflow = urllib.parse.quote(str(self.settings.steward["ci_workflow"]))
        self._call("POST", f"/actions/workflows/{workflow}/dispatches", {"ref": branch})

    def ci_state(self, branch: str, sha: str) -> Tuple[str, str]:
        workflow = urllib.parse.quote(str(self.settings.steward["ci_workflow"]))
        data = self._call("GET", f"/actions/workflows/{workflow}/runs?branch={urllib.parse.quote(branch)}&per_page=20")
        runs = [r for r in data.get("workflow_runs", []) if r.get("head_sha") == sha]
        if not runs:
            return "missing", ""
        run = max(runs, key=lambda r: (int(r.get("run_number") or 0), int(r.get("run_attempt") or 0)))
        url = str(run.get("html_url") or "")
        if run.get("status") != "completed":
            return "pending", url
        conclusion = str(run.get("conclusion") or "")
        if conclusion == "success":
            return "success", url
        return ("cancelled", url) if conclusion in ("cancelled", "skipped", "stale") else ("failure", url)

    def trigger_deploy(self, sha: str) -> None:
        workflow = str(self.settings.steward["deploy_workflow"])
        if workflow:
            self._call(
                "POST",
                f"/actions/workflows/{urllib.parse.quote(workflow)}/dispatches",
                {"ref": self.settings.trunk, "inputs": {"sha": sha}},
            )

    def redeploy(self, sha: str) -> None:
        self.trigger_deploy(sha)

    def trigger_tick(self) -> None:
        workflow = urllib.parse.quote(str(self.settings.steward["steward_workflow"]))
        self._call("POST", f"/actions/workflows/{workflow}/dispatches", {"ref": self.settings.trunk})

    def deploy_conclusion(self, pipeline: str, jobs: Sequence[str]) -> str:
        raise ConfigError("--conclusion auto is the GitLab form; a GitHub deploy job passes success or failure")


class GitLabAPI:
    def __init__(self, token: str, settings: Settings, git: Git) -> None:
        url = remote_url(git, settings.remote)
        base = str(settings.steward["gitlab_url"]).rstrip("/")
        project = str(settings.steward["gitlab_project"])
        if not base or not project:
            parsed = host_and_path(url)
            if not parsed:
                raise ConfigError(f"set steward.gitlab_url and steward.gitlab_project (remote URL {redact(url)!r})")
            base = base or parsed[0]
            project = project or parsed[1]
        self.api = f"{base}/api/v4/projects/{urllib.parse.quote(project, safe='')}"
        self.settings = settings
        self.headers = {"PRIVATE-TOKEN": token}

    def _call(self, method: str, path: str, payload: Any = None) -> Any:
        return http_json(method, f"{self.api}{path}", self.headers, payload)

    def _pages(self, path: str, limit: int = 30) -> List[Any]:
        items: List[Any] = []
        joiner = "&" if "?" in path else "?"
        for page in range(1, limit + 1):
            chunk = self._call("GET", f"{path}{joiner}per_page=100&page={page}")
            items.extend(chunk)
            if len(chunk) < 100:
                break
        return items

    def _merge_request(self, data: Dict[str, Any], enqueued_at: str = "") -> PullRequest:
        return PullRequest(
            number=int(data["iid"]),
            title=str(data.get("title") or ""),
            head_sha=str(data.get("sha") or ""),
            base_ref=str(data.get("target_branch") or ""),
            draft=bool(data.get("draft") or data.get("work_in_progress")),
            body=str(data.get("description") or ""),
            url=str(data.get("web_url") or ""),
            labels=[str(label) for label in data.get("labels", [])],
            enqueued_at=enqueued_at or str(data.get("created_at") or ""),
        )

    def queued_prs(self, label: str) -> List[PullRequest]:
        found = []
        quoted = urllib.parse.quote(label)
        for item in self._pages(f"/merge_requests?state=opened&labels={quoted}"):
            iid = int(item["iid"])
            stamp = ""
            for event in self._pages(f"/merge_requests/{iid}/resource_label_events", limit=10):
                if event.get("action") == "add" and (event.get("label") or {}).get("name") == label:
                    stamp = str(event.get("created_at") or stamp)
            found.append(self._merge_request(item, stamp))
        return found

    def pr(self, number: int) -> PullRequest:
        return self._merge_request(self._call("GET", f"/merge_requests/{number}"))

    def pr_state(self, number: int) -> str:
        state = str(self._call("GET", f"/merge_requests/{number}").get("state"))
        return {"merged": "merged", "closed": "closed"}.get(state, "open")

    def merge_commit(self, number: int) -> Optional[str]:
        data = self._call("GET", f"/merge_requests/{number}")
        if data.get("state") != "merged":
            return None
        sha = data.get("merge_commit_sha") or data.get("squash_commit_sha") or data.get("sha")
        return str(sha) if sha else None

    def pr_files(self, number: int) -> List[str]:
        files: List[str] = []
        for diff in self._pages(f"/merge_requests/{number}/diffs"):
            for key in ("new_path", "old_path"):
                path = str(diff.get(key) or "")
                if path and path not in files:
                    files.append(path)
        return files

    def head_ci(self, pr: PullRequest) -> str:
        data = self._call("GET", f"/merge_requests/{pr.number}")
        pipeline = data.get("head_pipeline") or {}
        if not pipeline or str(pipeline.get("sha")) != pr.head_sha:
            return "none" if not pipeline else "pending"
        status = str(pipeline.get("status"))
        if status == "success":
            return "success"
        if status in ("failed", "canceled", "skipped"):
            return "failure"
        return "pending"

    def pr_approved(self, pr: PullRequest) -> bool:
        data = self._call("GET", f"/merge_requests/{pr.number}/approvals")
        return bool(data.get("approved")) or int(data.get("approvals_left") or 0) == 0 and bool(data.get("approved_by"))

    def pr_head_refspec(self, number: int) -> str:
        return f"+refs/merge-requests/{number}/head:refs/steward/pr/{number}"

    def pr_add_labels(self, number: int, labels: Sequence[str]) -> None:
        self._call("PUT", f"/merge_requests/{number}", {"add_labels": ",".join(labels)})

    def pr_remove_label(self, number: int, label: str) -> None:
        self._call("PUT", f"/merge_requests/{number}", {"remove_labels": label})

    def pr_comment(self, number: int, text: str) -> None:
        self._call("POST", f"/merge_requests/{number}/notes", {"body": text})

    def pr_comment_texts(self, number: int) -> List[str]:
        notes = self._pages(f"/merge_requests/{number}/notes?sort=asc&order_by=created_at")
        return [str(n.get("body") or "") for n in notes if not n.get("system")]

    def pr_close(self, number: int) -> None:
        self._call("PUT", f"/merge_requests/{number}", {"state_event": "close"})

    def issue(self, number: int) -> Issue:
        data = self._call("GET", f"/issues/{number}")
        notes = [
            str(n.get("body") or "")
            for n in self._pages(f"/issues/{number}/notes?sort=asc&order_by=created_at")
            if not n.get("system")
        ]
        return Issue(
            number=number,
            state="open" if data.get("state") == "opened" else "closed",
            body=str(data.get("description") or ""),
            labels=[str(label) for label in data.get("labels", [])],
            comments=notes,
        )

    def issues_with_label(self, label: str) -> List[int]:
        items = self._pages(f"/issues?state=opened&labels={urllib.parse.quote(label)}")
        return sorted(int(item["iid"]) for item in items)

    def issue_add_labels(self, number: int, labels: Sequence[str]) -> None:
        self._call("PUT", f"/issues/{number}", {"add_labels": ",".join(labels)})

    def issue_remove_label(self, number: int, label: str) -> None:
        self._call("PUT", f"/issues/{number}", {"remove_labels": label})

    def issue_comment(self, number: int, text: str) -> None:
        self._call("POST", f"/issues/{number}/notes", {"body": text})

    def issue_set_body(self, number: int, body: str) -> None:
        self._call("PUT", f"/issues/{number}", {"description": body})

    def issue_close(self, number: int) -> None:
        self._call("PUT", f"/issues/{number}", {"state_event": "close"})

    def issue_release_claim(self, number: int, in_progress_label: str) -> None:
        self._call("PUT", f"/issues/{number}", {"remove_labels": in_progress_label, "assignee_ids": [0]})

    def trigger_ci(self, branch: str) -> None:
        return None  # the push of the train branch with the steward's token starts its pipeline

    def ci_state(self, branch: str, sha: str) -> Tuple[str, str]:
        ref = urllib.parse.quote(branch)
        pipelines = self._call("GET", f"/pipelines?ref={ref}&sha={sha}&order_by=id&sort=desc&per_page=5")
        if not pipelines:
            return "missing", ""
        pipeline = pipelines[0]
        url = str(pipeline.get("web_url") or "")
        status = str(pipeline.get("status"))
        if status == "success":
            return "success", url
        if status == "failed":
            return "failure", url
        if status in ("canceled", "skipped"):
            return "cancelled", url
        return "pending", url

    def trigger_deploy(self, sha: str) -> None:
        return None  # the fast-forward push of the trunk starts the trunk pipeline, which deploys

    def redeploy(self, sha: str) -> None:
        """A fresh trunk pipeline, for `reverify` (no push happens, so nothing else would start one). The deploy
        jobs and `delivery-verdict` admit it through MERGE_STEWARD=redeploy (templates/ci)."""
        self._call(
            "POST",
            "/pipeline",
            {"ref": self.settings.trunk, "variables": [{"key": "MERGE_STEWARD", "value": "redeploy"}]},
        )

    def trigger_tick(self) -> None:
        self._call(
            "POST",
            "/pipeline",
            {"ref": self.settings.trunk, "variables": [{"key": "MERGE_STEWARD", "value": "tick"}]},
        )

    def deploy_conclusion(self, pipeline: str, jobs: Sequence[str]) -> str:
        """success / failure / none for the listed jobs of a trunk pipeline. An outdated (superseded) deployment
        job is NOT a failure: GitLab fails it with `forward_deployment_failure`, and the newer deploy will
        render the verdict."""
        listed = {name.strip() for name in jobs if name.strip()}
        statuses: Dict[str, Tuple[str, str]] = {}
        for job in self._pages(f"/pipelines/{pipeline}/jobs?include_retried=false"):
            name = str(job.get("name"))
            if name in listed:
                status = str(job.get("status"))
                if status == "failed" and job.get("allow_failure"):
                    # The pipeline itself passes (with a warning): a job the jobs API reports with
                    # `allow_failure: true` failed in a way the project declared acceptable — not a failed deploy.
                    print(f"merge_steward: deploy job {name} failed, but is allowed to fail — counted as passed")
                    status = "success"
                statuses[name] = (status, str(job.get("failure_reason") or ""))
        if any(reason == "forward_deployment_failure" for _status, reason in statuses.values()):
            return "none"
        if any(status == "failed" for status, _reason in statuses.values()):
            return "failure"
        if listed and all(statuses.get(name, ("",))[0] == "success" for name in listed):
            return "success"
        return "none"


