#!/usr/bin/env bash
# scripts/setup-hooks.sh — installs a project-local pre-commit hook AND
# points git at the project's own hooks for every operation. Run once
# per clone, from the main checkout (not a worktree).
#
# Why this pattern: the standard `pre-commit install` writes a hook
# that depends on the system PATH. On a machine that hosts multiple
# Python projects, that PATH is unreliable — especially when git is
# invoked from an IDE or a GUI client that does not activate the venv.
# This script writes a hook that hardcodes the absolute path to the
# project's venv `pre-commit` executable, sidestepping all PATH
# resolution concerns.
#
# Why it also sets core.hooksPath: some environments install a
# system-level git hooks directory (e.g. a corporate security tool such
# as git-defender writes `core.hooksPath` into the SYSTEM gitconfig).
# When that is set, git ignores this project's `.git/hooks` entirely, so
# the pre-commit hook below would never run and you would have to pass
# `-c core.hooksPath=...` on every command. Setting core.hooksPath in
# the repo's LOCAL config overrides the system value for THIS repo only,
# so every git operation — terminal, IDE, GUI client, and any automated
# agent — uses the project hooks automatically with no per-command flag.
# The path is stored ABSOLUTE on purpose: a relative `.git/hooks` does
# not resolve inside git worktrees (a worktree's `.git` is a file, not a
# directory), which would silently skip the hooks for worktree commits.
# NOTE: this override means a system hooks tool (git-defender, etc.) no
# longer runs for this repo. That is the intended trade-off here.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || "$OSTYPE" == "win32" ]]; then
    PRECOMMIT_PATH="$PROJECT_ROOT/venv/Scripts/pre-commit.exe"
else
    PRECOMMIT_PATH="$PROJECT_ROOT/venv/bin/pre-commit"
fi

if [ ! -x "$PRECOMMIT_PATH" ]; then
    echo "ERROR: pre-commit not found at $PRECOMMIT_PATH" >&2
    echo "Run: pip install -e '.[dev]' inside an activated venv first." >&2
    exit 1
fi

cat > "$PROJECT_ROOT/.git/hooks/pre-commit" << HOOK
#!/usr/bin/env bash
# Auto-generated by scripts/setup-hooks.sh — do not edit by hand.
# Pre-commit hook with absolute venv path to avoid PATH issues.
# Runs only fast checks (ruff lint + format). Slow checks (mypy,
# pytest, bandit) are left for CI or manual invocation.
PRECOMMIT="$PRECOMMIT_PATH"
if [ ! -x "\$PRECOMMIT" ]; then
    echo "ERROR: pre-commit not found at \$PRECOMMIT" >&2
    echo "Recreate venv: python -m venv venv && pip install -e '.[dev]'" >&2
    exit 1
fi
"\$PRECOMMIT" run ruff --config .pre-commit-config.yaml || exit \$?
exec "\$PRECOMMIT" run ruff-format --config .pre-commit-config.yaml
HOOK

chmod +x "$PROJECT_ROOT/.git/hooks/pre-commit"
echo "Pre-commit hook installed at $PROJECT_ROOT/.git/hooks/pre-commit"
echo "Using venv pre-commit: $PRECOMMIT_PATH"

# Point THIS repo at its own hooks via LOCAL config, overriding any
# system-level core.hooksPath (e.g. git-defender). Use the common git dir
# so the value is correct even when this runs from a worktree, and make it
# absolute so it resolves from any worktree or subdirectory.
HOOKS_DIR="$(cd "$(git -C "$PROJECT_ROOT" rev-parse --git-common-dir)" && pwd)/hooks"
git -C "$PROJECT_ROOT" config --local core.hooksPath "$HOOKS_DIR"
echo "Set local core.hooksPath -> $HOOKS_DIR"
PREV_HOOKS="$(git -C "$PROJECT_ROOT" config --system --get core.hooksPath 2>/dev/null || true)"
if [ -n "$PREV_HOOKS" ]; then
    echo "NOTE: overriding system core.hooksPath ($PREV_HOOKS) for this repo only;"
    echo "      a system hooks tool (e.g. git-defender) will not run here."
fi
